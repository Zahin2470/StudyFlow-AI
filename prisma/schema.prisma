// Phase 1 subset: auth-only models. Academic entities (Semester, Course,
// Assignment, Exam, Note, Document, GradeEntry, StudySession, StudyGroup...)
// are added in Phase 2 per ARCHITECTURE.md — not stubbed here on purpose.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  ADMIN
}

enum AcademicLevel {
  HIGH_SCHOOL
  UNDERGRADUATE
  GRADUATE
}

model User {
  id             String    @id @default(cuid())
  name           String
  email          String    @unique
  emailVerified  DateTime?
  passwordHash   String?   // null when the user only signed up via OAuth
  image          String?
  role           Role      @default(STUDENT)

  institution    String?
  academicLevel  AcademicLevel?
  onboardedAt    DateTime?

  accounts       Account[]
  sessions       Session[]

  semesters      Semester[]
  courses        Course[]
  studySessions  StudySession[]

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

// ---------------------------------------------------------------------------
// Phase 2: academic data model. Course carries a denormalized `userId`
// alongside its `semesterId` — every course/assignment/exam query in the
// repositories filters on it directly instead of joining up through
// Semester on every read, which matters once a student has several
// semesters of history (see ARCHITECTURE.md §9 scalability notes).
// ---------------------------------------------------------------------------

model Semester {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String   // e.g. "Fall 2026"
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(false)

  courses   Course[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Course {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  semesterId String
  semester   Semester @relation(fields: [semesterId], references: [id], onDelete: Cascade)

  code       String   // e.g. "CSE420"
  name       String
  instructor String?
  credits    Float
  color      String   @default("#3454D1")

  assignments   Assignment[]
  exams         Exam[]
  studySessions StudySession[]
  notes         Note[]
  documents     Document[]

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
  @@index([semesterId])
}

enum AssignmentStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  GRADED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

model Assignment {
  id          String           @id @default(cuid())
  courseId    String
  course      Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)

  title       String
  description String?          @db.Text
  dueDate     DateTime
  status      AssignmentStatus @default(NOT_STARTED)
  priority    Priority         @default(MEDIUM)
  weight      Float?           // % of final grade — used by GPA phase (6), optional here

  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([courseId])
  @@index([dueDate])
}

model Exam {
  id        String   @id @default(cuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  title     String
  examDate  DateTime
  location  String?
  notes     String?  @db.Text
  weight    Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courseId])
  @@index([examDate])
}

model StudySession {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId          String?  // optional — a session doesn't have to be tied to one course
  course            Course?  @relation(fields: [courseId], references: [id], onDelete: SetNull)

  title             String?
  scheduledStart    DateTime
  scheduledEnd      DateTime
  completed         Boolean  @default(false)
  actualDurationMin Int?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([userId])
  @@index([scheduledStart])
}

// ---------------------------------------------------------------------------
// Phase 5: Notes and Documents. Document.storageKey lets the storage
// adapter delete the underlying file later without parsing the URL — see
// ARCHITECTURE.md §16 for the storage-provider abstraction (local disk now,
// swappable for S3/Supabase later, same pattern as the AI provider in §5).
// ---------------------------------------------------------------------------

model Note {
  id        String   @id @default(cuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  title     String
  content   String   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courseId])
}

model Document {
  id         String   @id @default(cuid())
  courseId   String
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  title      String
  fileUrl    String
  storageKey String   // opaque key the storage adapter uses to delete the file later
  fileType   String
  fileSize   Int      // bytes

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([courseId])
}

// Standard Auth.js (NextAuth) adapter models below.

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Shared by email verification and password reset — `purpose` distinguishes them.
model VerificationToken {
  identifier String
  token      String   @unique
  purpose    String   // "email-verify" | "password-reset"
  expires    DateTime

  @@unique([identifier, token])
}
